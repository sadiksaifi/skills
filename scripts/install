#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

source "$SCRIPT_DIR/skills-config"

if [[ -n "${AGENTS:-}" ]]; then
  read -r -a AGENT_ARGS <<< "$AGENTS"
else
  AGENT_ARGS=(claude-code codex hermes-agent)
fi

load_skills

for index in "${!SKILL_NAMES[@]}"; do
  skill_name="${SKILL_NAMES[$index]}"
  skill_source="${SKILL_SOURCES[$index]}"

  echo "Installing $skill_name"
  npx --yes skills@latest add "$skill_source" --skill "$skill_name" -g -a "${AGENT_ARGS[@]}" -y
done
