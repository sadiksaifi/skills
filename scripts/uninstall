#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

source "$SCRIPT_DIR/skills-config"

if [[ -n "${AGENTS:-}" ]]; then
  read -r -a AGENT_ARGS <<< "$AGENTS"
else
  AGENT_ARGS=(claude-code codex hermes-agent)
fi

load_skills

for skill_name in "${SKILL_NAMES[@]}"; do
  echo "Uninstalling $skill_name"
  npx --yes skills@latest remove -g "$skill_name" -a "${AGENT_ARGS[@]}" -y
done
