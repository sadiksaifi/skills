#!/usr/bin/env bash

append_skill() {
  local section="$1" skill_source="$2" skill_name="$3"

  if [[ -z "$skill_source" || -z "$skill_name" ]]; then
    echo "skills.ini: [$section] requires source and skill" >&2
    return 1
  fi

  case "$skill_source" in
    ./*|../*) skill_source="$REPO_ROOT/$skill_source" ;;
  esac

  SKILL_SOURCES+=("$skill_source")
  SKILL_NAMES+=("$skill_name")
}

load_skills() {
  local line section="" skill_source="" skill_name=""
  SKILL_SOURCES=()
  SKILL_NAMES=()

  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"

    case "$line" in
      ""|\#*|\;*) continue ;;
      \[*\])
        if [[ -n "$section" ]]; then
          append_skill "$section" "$skill_source" "$skill_name" || return 1
        fi
        section="${line:1:${#line}-2}"
        skill_source=""
        skill_name=""
        continue
        ;;
    esac

    if [[ -z "$section" ]]; then
      echo "skills.ini: expected a section header before $line" >&2
      return 1
    fi

    case "$line" in
      source=*) skill_source="${line#source=}" ;;
      skill=*) skill_name="${line#skill=}" ;;
      *) echo "skills.ini: invalid entry in [$section]: $line" >&2; return 1 ;;
    esac
  done < "$REPO_ROOT/skills.ini"

  if [[ -n "$section" ]]; then
    append_skill "$section" "$skill_source" "$skill_name" || return 1
  fi

  if [[ ${#SKILL_NAMES[@]} -eq 0 ]]; then
    echo "skills.ini: no skills configured" >&2
    return 1
  fi
}
